# -------------------------------------
# Welcome Page
welcome-heading = Script Pilot

welcome-para-01 =
    Script Pilot helps keep track of medicines, prescriptions and repeats in one place.
    It makes it easier to see what is on hand, what is due next, and which prescription
    to use.

welcome-para-02 =
    All information is stored only on the device.
    Script Pilot is a personal organiser to help manage prescription records.
    It does not provide medical advice or replace guidance from a doctor or
    pharmacist.

welcome-continue-button =
    .text = Continue


